<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <Button android:id="@+id/backButton" android:layout_width="44dp" android:layout_height="44dp" android:text="←" android:textSize="20sp" />
        <Button android:id="@+id/forwardButton" android:layout_width="44dp" android:layout_height="44dp" android:text="→" android:textSize="20sp" />
        <Button android:id="@+id/reloadButton" android:layout_width="44dp" android:layout_height="44dp" android:text="↻" android:textSize="20sp" />
        <Button android:id="@+id/homeButton" android:layout_width="44dp" android:layout_height="44dp" android:text="Ω" android:textSize="18sp" />

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:hint="@string/address_hint"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:background="@drawable/address_bar_background" />

        <Button
            android:id="@+id/openButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/open"
            android:textAllCaps="false"
            android:background="@drawable/open_button_background"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/omegaContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/addOmegaButton"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:text="+Ω"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/open_button_background" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
